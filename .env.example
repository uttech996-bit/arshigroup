# Supabase public client configuration
NEXT_PUBLIC_SUPABASE_URL=https://tadrqecrqvenoferfjhh.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Optional legacy compatibility. If present, the app prefers this key during
# migration so an older valid Vercel anon key can keep authentication online.
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# One-time admin bootstrap. NEVER commit real values to GitHub.
# Set these only in Vercel Environment Variables, call the protected bootstrap
# endpoint once, then remove all four bootstrap variables.
SUPABASE_SERVICE_ROLE_KEY=
ARSHI_BOOTSTRAP_SECRET=
ARSHI_BOOTSTRAP_ADMIN_EMAIL=admin@arshigroup.com
ARSHI_BOOTSTRAP_ADMIN_PASSWORD=
